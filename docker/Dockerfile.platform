# Deterministic platform tests: no ROS installation or robot stack.
FROM python:3.12-slim
WORKDIR /workspace
COPY --from=sdk . /workspace/ringfour-sdk
COPY --from=agent . /workspace/ringfour-agent
COPY . /workspace/ringfour-testing
RUN pip install --no-cache-dir ./ringfour-sdk ./ringfour-agent ./ringfour-testing
WORKDIR /workspace/ringfour-testing
ENV PYTEST_DISABLE_PLUGIN_AUTOLOAD=1
CMD ["python", "-m", "pytest", "-q", "--tb=short", "--basetemp=/tmp/rf-tests"]
